// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  // One user has many authentication sessions
  sessions            Session[]
  // One user has many project memberships
  projectMemberships  ProjectMembership[]
  // One user creates many tasks
  createdTasks        Task[]              @relation("TaskCreator")
  // One user is assigned many tasks
  assignedTasks       Task[]              @relation("TaskAssignee")
  // One user comments on many tasks
  comments            Comment[]
  // One user creates many invitations
  sentInvitations     Invitation[]        @relation("InvitationInviter")
  // One user is invited to many projects
  receivedInvitations Invitation[]        @relation("InvitationInvitee")
}

enum UserRole {
  ADMIN
  USER
}

model Session {
  id               String    @id @default(uuid())
  refreshTokenHash String
  userId           String
  familyId         String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relationships
  // Many sessions belong to one user
  // When a user is deleted, all their sessions are deleted
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for faster session lookups
  @@index([userId])
  @@index([familyId])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One project has many project memberships
  projectMemberships ProjectMembership[]
  tasks              Task[]
  invitations        Invitation[]
}

model ProjectMembership {
  id String @id @default(uuid())

  userId    String
  projectId String

  role ProjectRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  // Many project memberships belong to one user
  // When a user is deleted, all their project memberships are deleted
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Many project memberships belong to one project
  // When a project is deleted, all its project memberships are deleted
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Unique constraint to prevent a user from having multiple memberships in the same project
  @@unique([userId, projectId])
  @@index([projectId])
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  projectId   String
  createdById String?
  assigneeId  String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueDate  DateTime?

  // Relationships
  // Many tasks belong to one project
  // When a project is deleted, all its tasks are deleted
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Comment {
  id      String @id @default(uuid())
  content String

  authorId String
  taskId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Invitation {
  id String @id @default(uuid())

  projectId String
  inviterId String
  inviteeId String

  role   InvitationRole
  status InvitationStatus @default(PENDING)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  inviter User @relation("InvitationInviter", fields: [inviterId], references: [id])

  invitee User @relation("InvitationInvitee", fields: [inviteeId], references: [id])

  @@index([projectId])
}

enum InvitationRole {
  MANAGER
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}
