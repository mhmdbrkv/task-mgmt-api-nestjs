// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  // One user has many authentication sessions
  sessions           Session[]
  // One user has many project memberships
  projectMemberships ProjectMembership[]
}

enum UserRole {
  ADMIN
  USER
}

model Session {
  id               String    @id @default(uuid())
  refreshTokenHash String
  userId           String
  familyId         String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relationships
  // Many sessions belong to one user
  // When a user is deleted, all their sessions are deleted
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for faster session lookups
  @@index([userId])
  @@index([familyId])
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One project has many project memberships
  projectMemberships ProjectMembership[]
}

model ProjectMembership {
  id String @id @default(uuid())

  userId    String
  projectId String

  role ProjectRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  // Many project memberships belong to one user
  // When a user is deleted, all their project memberships are deleted
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Many project memberships belong to one project
  // When a project is deleted, all its project memberships are deleted
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Unique constraint to prevent a user from having multiple memberships in the same project
  @@unique([userId, projectId])
  @@index([projectId])
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
}
